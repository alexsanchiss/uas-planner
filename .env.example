# =============================================================================
# UPPS - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values
# 
# IMPORTANT: Never commit .env.local to version control!
#
# Legend (every variable the code reads is listed here):
#   [required] / [optional]  - the app needs it / works without it (default noted)
#   [server]                 - read only by server code, never sent to the browser
#   [public]                 - NEXT_PUBLIC_*: inlined into the bundle AT BUILD TIME (also when
#                              read by server code), so changing it requires `next build` again
# Placeholder values only - put real secrets in your own .env.local / .env.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (REQUIRED)
# -----------------------------------------------------------------------------
# [required] [server] MySQL connection string for Prisma ORM
# Also read (through dotenv) by traj-assigner.js and machine-cleaner.js
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
#
# Examples:
#   Local:      mysql://root:password@localhost:3306/uas_planner
#   Docker:     mysql://root:password@db:3306/uas_planner
#   Production: mysql://uas_user:securepass@db.example.com:3306/upps
#
DATABASE_URL="mysql://USER:PASSWORD@XXX.XX.XXX.XXX:3306/upps"

# -----------------------------------------------------------------------------
# AUTHENTICATION (REQUIRED)
# -----------------------------------------------------------------------------
# [required] [server] JWT Secret for signing authentication tokens
# (the server refuses to start in production without it; also signs password-reset tokens)
# 
# SECURITY REQUIREMENTS:
# - Use a cryptographically secure random string (min 32 characters)
# - Never share or commit the real secret
# - Use different secrets for development/staging/production
#
# Generate a secure secret:
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
JWT_SECRET="your-secure-random-secret-here"

# [required for /api/machine/*] [server] Shared key the trajectory VMs send in the
# x-machine-api-key header. If unset, every /api/machine/* route answers 500.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MACHINE_API_KEY="your-machine-api-key-here"

# -----------------------------------------------------------------------------
# EXTERNAL SERVICES (OPTIONAL)
# -----------------------------------------------------------------------------
# [optional] [server] MailerSend API Key for transactional emails
# Without a valid key (or with the placeholder below) emails are silently skipped.
# Used for email verification, password reset, and authorization notifications
#
# Get your API key at: https://www.mailersend.com/
#
MAILERSEND_API_KEY="your_mailersend_api_key_here"

# [optional] [server] Sender address and display name of outgoing emails
# Defaults: UPPS@sna-upv.com / UPPS
# MAILERSEND_SENDER_EMAIL="sender@example.com"
# MAILERSEND_SENDER_NAME="UPPS"

# [optional] [server] Recipient of the contact-us / support tickets (default: UPPS@sna-upv.com)
# SUPPORT_EMAIL="support@example.com"

# [required in production] [public] Public base URL of the app, used for the links and
# images inside emails (verification, password reset, authorization result).
# Default: http://localhost:3001
NEXT_PUBLIC_APP_URL="https://upps.example.com"

# [optional] [server] Cesium ion access token for the 3D viewers. Served to logged-in
# users by GET /api/cesium/token. Without it that route answers 500 and the 3D views fail.
# Get one at: https://ion.cesium.com/tokens
CESIUM_ION_TOKEN="your-cesium-ion-token-here"

# [optional] [server] FAS (Flight Authorization Service) API URL
# Used for U-Plan submission and flight authorization requests
#
# The application will send POST requests to this URL with U-Plan JSON
# when users request flight authorization.
#
# Default: http://158.42.167.56:8000/uplan (SNA Lab FAS server)
#
FAS_API_URL="http://158.42.167.56:8000/uplan"

# [optional] [server] FAS callback source-IP allowlist
# Comma-separated IPs allowed to call PUT /api/fas/<externalResponseNumber>.
# Unset/empty = any source is accepted (legacy behaviour).
# Every callback logs one line "[FAS Callback] source IP: <ip> allowed: <bool>",
# so first leave this unset, read FAS's real IP from the logs, then enable it.
#
# Proxy assumption: the source IP is the RIGHT-MOST X-Forwarded-For entry (else
# X-Real-IP), i.e. the one the reverse proxy (Caddy) appended itself. This is only
# trustworthy if all traffic goes through Caddy; direct access to the Next.js port
# (:3003) bypasses the proxy and lets a caller forge those headers.
#
# FAS_CALLBACK_ALLOWED_IPS="203.0.113.10,203.0.113.11"

# -----------------------------------------------------------------------------
# GEOAWARENESS SERVICE (OPTIONAL)
# -----------------------------------------------------------------------------
# [optional] [server] Geoawareness Service IP address (host:port)
# Without it: /api/geoawareness/uspaces answers 503 and the SSE stream sends an error event.
# Used for fetching U-spaces, geozones data, and WebSocket connections
#
# This service provides:
# - List of available U-spaces: GET http://<IP>/<USPACES_ENDPOINT>
# - Geozones search: POST http://<IP>/<ENDPOINT>
# - WebSocket for real-time geozone updates: ws://<IP>/ws/gas/{uspace_id}
#
# NOTE: This variable uses NEXT_PUBLIC_ prefix to be accessible in both
# server-side API routes and client-side WebSocket connections.
#
# HTTPS NOTE: When serving the app over HTTPS, the WebSocket connection is
# automatically upgraded from ws:// to wss:// to avoid mixed-content errors.
# Architecture: the browser connects to the Next.js backend via SSE (HTTPS-safe),
# and the backend opens a plain ws:// connection to the geoawareness service on the
# internal network.  This avoids mixed-content errors when the app is served over
# HTTPS and the geoawareness service is plain HTTP/WS.
#
# Only GEOAWARENESS_SERVICE_IP is needed (server-side).
# NEXT_PUBLIC_GEOAWARENESS_SERVICE_IP is no longer used and can be removed.
#
GEOAWARENESS_SERVICE_IP="158.42.167.56:8001"
# NEXT_PUBLIC_GEOAWARENESS_SERVICE_IP="158.42.167.56:8001"  # Deprecated — no longer needed

# [optional] [server] Path prefix for the geoawareness WebSocket endpoint (default: ws/gas/)
# Full internal WS URL: ws://{GEOAWARENESS_SERVICE_IP}/{GEOAWARENESS_ENDPOINT}{uspace_identifier}
GEOAWARENESS_ENDPOINT="ws/gas/"

# [optional] [server] Endpoint for fetching list of available U-spaces (default: uspaces)
# Set to "PRUEBA" to use hardcoded test U-spaces (CVUspace, PuertoVLC, VLCUspace)
GEOAWARENESS_USPACES_ENDPOINT="uspaces"

# -----------------------------------------------------------------------------
# FEATURE FLAGS (OPTIONAL)
# -----------------------------------------------------------------------------
# [optional] [public] Production Mode for FlightPlansUploader component
#
# Values:
#   "true"  - Uses production version with guided workflow, no bulk operations
#   "false" - Uses development version with all features including bulk ops
#
# The production version provides a cleaner UX for end users, while the
# development version includes advanced features for power users/testing.
#
# Default: "false" (development mode)
#
NEXT_PUBLIC_PRODUCTION_MODE="false"

# [optional] [public] Generate Random U-Plan Data (read by server AND client with the same rule:
# enabled unless the value is exactly "false"; see lib/uplan/random-data.ts)
#
# Values:
#   "true"  - Generates complete U-Plan with random placeholder data
#             (useful for testing and development)
#   "false" - Generates only operation volumes, user must fill all other
#             fields manually through the U-Plan form
#
# When false, users must complete the U-Plan form before submitting to FAS.
# The validation will prevent submission with incomplete data.
#
# Default when unset: "true" (generate random data for compatibility)
#
NEXT_PUBLIC_GENERATE_RANDOM_UPLAN_DATA="true"

# [optional] [public] Planned Home Altitude (AMSL ground elevation in meters)
#
# The QGC .plan file sets mission.plannedHomePosition[2] to this value.
# Waypoint altitudes and the trajectory CSV `Alt` are metres above the takeoff (home)
# point; volume generation uses `Alt` as is (no subtraction since commit b7797f4).
# The plan viewer draws them on the terrain height at takeoff (lib/altitude.ts).
#
# Default: 15
#
NEXT_PUBLIC_PLANNED_HOME_ALTITUDE="15"

# -----------------------------------------------------------------------------
# DEVELOPMENT OPTIONS (OPTIONAL)
# -----------------------------------------------------------------------------
# [optional] [server] Minimum log level outside production: debug | info | warn | error
# (production always logs from "info"). Default: debug
# LOG_LEVEL="debug"

# NODE_ENV is set by Next.js itself ("development" | "production" | "test"); do not set it here.
# The listening port is not an env var: it is fixed in package.json (`-p 3003`).
# NEXT_RUNTIME and NEXT_PHASE are also set by Next.js internally.

# -----------------------------------------------------------------------------
# NOTES
# -----------------------------------------------------------------------------
# 
# Required variables that will cause startup failure if missing:
#   - DATABASE_URL
#   - JWT_SECRET
# Required for specific features only: MACHINE_API_KEY (/api/machine/*),
# NEXT_PUBLIC_APP_URL (email links in production), CESIUM_ION_TOKEN (3D viewers).
#
# The application validates these at startup and will display helpful
# error messages if they are not configured.
#
# For local development with Docker:
#   docker-compose up -d
#   # This will start MySQL and set DATABASE_URL automatically
#