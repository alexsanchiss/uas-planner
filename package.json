  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3003",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3003",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "copy-cesium": "node -e \"const fs=require('fs'),p=require('path');const s=p.join('node_modules','cesium','Build','Cesium'),d=p.join('public','cesium');if(fs.existsSync(s)){fs.mkdirSync(d,{recursive:true});fs.cpSync(s,d,{recursive:true});console.log('Cesium assets copied to public/cesium')}else{console.error('cesium Build not found')}\"",
    "postinstall": "npm run copy-cesium",
    "prebuild": "npm run copy-cesium"
  },
